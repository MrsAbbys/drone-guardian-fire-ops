[gd_scene load_steps=6 format=3 uid="uid://water_drop_particle_01"]

[sub_resource type="GDScript" id="Script_WaterDrop"]
script/source = "extends Node3D

@export var damage: float = 25.0
var drop_speed: float = 32.0

func _ready() -> void:
	var area = $Area3D
	if area:
		area.area_entered.connect(_on_area_entered)
		area.body_entered.connect(_on_body_entered)

func _process(delta: float) -> void:
	global_position.y -= drop_speed * delta
	if global_position.y <= 0.2:
		queue_free()

func _on_area_entered(other_area: Area3D) -> void:
	# Si choca con el área del fuego o su padre
	var target = other_area.get_parent()
	if target and target.has_method(\"apply_water_damage\"):
		target.apply_water_damage(damage)
		queue_free()
	elif other_area.has_method(\"apply_water_damage\"):
		other_area.apply_water_damage(damage)
		queue_free()

func _on_body_entered(_body: Node) -> void:
	queue_free()
"

[sub_resource type="StandardMaterial3D" id="Mat_VoxelWater"]
transparency = 1
albedo_color = Color(0.2, 0.65, 1.0, 0.75)
roughness = 0.1
emission_enabled = true
emission = Color(0.2, 0.6, 1.0, 1.0)
emission_energy_multiplier = 1.5

[sub_resource type="BoxMesh" id="Mesh_WaterVoxel"]
material = SubResource("Mat_VoxelWater")
size = Vector3(0.9, 1.8, 0.9)

[sub_resource type="BoxShape3D" id="Shape_WaterHit"]
size = Vector3(2.0, 2.5, 2.0)

[node name="WaterSplash" type="Node3D"]
script = SubResource("Script_WaterDrop")

[node name="DropMesh" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_WaterVoxel")

[node name="Area3D" type="Area3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="Area3D"]
shape = SubResource("Shape_WaterHit")
